{
  "version": 2,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, OPTIONS" }
      ]
    }
  ],
  "builds": [
    {
      "src": "Frontend Code/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/manifest.json",
      "dest": "Frontend Code/manifest.json"
    },
    {
      "src": "/sw.js",
      "dest": "Frontend Code/sw.js"
    },
    {
      "src": "/icon-192.jpg",
      "dest": "Frontend Code/icon-192.jpg"
    },
    {
      "src": "/icon-512.jpg",
      "dest": "Frontend Code/icon-512.jpg"
    },
    {
      "src": "/(.*)",
      "dest": "Frontend Code/index.html"
    }
  ]
}
